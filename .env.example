# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
APP_NAME=alterpay-api
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# ---- HTTP ------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=info
# Pretty console output is only honoured when NODE_ENV != production.
LOG_PRETTY=true

# ---- Database --------------------------------------------------------------
# Required. Must be a PostgreSQL connection string.
DATABASE_URL=postgresql://alterpay:alterpay@localhost:5432/alterpay?schema=public

# ---- Lifecycle -------------------------------------------------------------
SHUTDOWN_TIMEOUT_MS=10000
HEALTH_PROBE_TIMEOUT_MS=5000

# ---- Observability (optional) ----------------------------------------------
# Omit SENTRY_DSN to run without Sentry; the app still boots and logs locally.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0

# ---- Provider routing ------------------------------------------------------
# Which counterparty serves which family, purpose, capability and merchant.
# Selection is configuration; wiring is code. Changing a pin here requires no
# redeploy of business logic and no vendor name appearing anywhere in it.
#
# All five variables are optional. An omitted family falls back to the built-in
# mock platform, which is why a fresh checkout boots with every family servable.
#
# Each variable is a JSON object:
#   {
#     "defaultProviderId": "vendor-a",
#     "providerIds": ["vendor-a", "vendor-b"],
#     "capabilities":         { "vendor-a": ["PAN", "GST"] },
#     "purposePreferences":   { "MERCHANT_ONBOARDING_VERIFICATION": ["vendor-a"] },
#     "capabilityPreferences": { "AADHAAR": ["vendor-b"] },
#     "merchantOverrides":    { "merch_1abc": ["vendor-b"] }
#   }
#
# Routing precedence, most specific first:
#   merchantOverrides -> purposePreferences -> capabilityPreferences -> defaultProviderId
#
# A provider that does not declare a capability is never selected for it, so a
# missing capability is reported rather than silently downgraded to a weaker
# check. Pinning a merchant to a provider that lacks the capability is ignored
# for that capability.

# PROVIDER_VERIFICATION={"defaultProviderId":"vendor-a","providerIds":["vendor-a"],"capabilities":{"vendor-a":["PAN","GST","MOBILE_OTP","ADDRESS"]}}
# PROVIDER_CREDIT_BUREAU={"defaultProviderId":"vendor-a","providerIds":["vendor-a"],"capabilities":{"vendor-a":["CREDIT_ENQUIRY","ACCOUNT_SUMMARY","CREDIT_SCORE"]}}
# PROVIDER_LENDING={"defaultProviderId":"vendor-a","providerIds":["vendor-a"],"capabilities":{"vendor-a":["OFFERS","APPLICATION_CREATE","APPLICATION_SUBMIT","APPLICATION_STATUS","LOAN","DISBURSEMENT"]}}
# PROVIDER_LOAN_MIRROR={"defaultProviderId":"vendor-a","providerIds":["vendor-a"],"capabilities":{"vendor-a":["APPLICATION_STATUS","LOAN","EMI_SCHEDULE","REPAYMENT","CLOSURE"]}}
# PROVIDER_OTP={"defaultProviderId":"vendor-a","providerIds":["vendor-a"],"capabilities":{"vendor-a":["OTP_SMS","OTP_EMAIL"]}}

# ---- Provider health -------------------------------------------------------
# Only availability failures count toward the circuit. A rejected application or a
# declined verification means the provider is working correctly, and taking a
# healthy provider out of rotation for a business reason would be a self-inflicted
# outage.
PROVIDER_HEALTH_FAILURE_THRESHOLD=5
PROVIDER_HEALTH_OPEN_DURATION_MS=30000
PROVIDER_HEALTH_SUCCESS_THRESHOLD=2
