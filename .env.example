# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
APP_NAME=alterpay-api
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# ---- HTTP ------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=info
# Pretty console output is only honoured when NODE_ENV != production.
LOG_PRETTY=true

# ---- Database --------------------------------------------------------------
# Required. Must be a PostgreSQL connection string.
DATABASE_URL=postgresql://alterpay:alterpay@localhost:5432/alterpay?schema=public

# ---- Lifecycle -------------------------------------------------------------
SHUTDOWN_TIMEOUT_MS=10000
HEALTH_PROBE_TIMEOUT_MS=5000

# ---- Observability (optional) ----------------------------------------------
# Omit SENTRY_DSN to run without Sentry; the app still boots and logs locally.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0
